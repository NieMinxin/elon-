# Market URL slug, for example the part after polymarket.com/market/
POLYMARKET_MARKET_SLUG=replace-with-market-slug
POLYMARKET_OUTCOME=YES

# Threshold strategy. All prices are between 0 and 1.
POLYMARKET_BUY_BELOW=0.40
POLYMARKET_TAKE_PROFIT_AT=0.60
POLYMARKET_STOP_LOSS_AT=0.25
POLYMARKET_ORDER_AMOUNT_USD=10
POLYMARKET_MAX_POSITION_SHARES=50
POLYMARKET_MAX_DAILY_BUY_USD=25
POLYMARKET_MAX_SLIPPAGE=0.02
POLYMARKET_POLL_INTERVAL_SECONDS=30
POLYMARKET_TRADE_COOLDOWN_SECONDS=300
POLYMARKET_STATE_PATH=bot-state.json

# Paper mode is the default. Real orders require BOTH this flag and --live.
POLYMARKET_ENABLE_LIVE=false

# Only required for real trading. Never commit these values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# Elon multi-range probability system (used by the elon-arb command).
ELON_EVENT_SLUG=elon-musk-of-tweets-october-13-october-20-2026
ELON_XTRACKER_HANDLE=elonmusk
ELON_FORECAST_STRATEGY=route
ELON_HISTORY_DAYS=365
# Live mode is blocked if the rolling holdout backtest misses either limit.
ELON_MIN_BACKTEST_COVERAGE=0.65
ELON_MAX_BACKTEST_MAE=50
# Retained for the legacy Gamma-Poisson model and compatibility tests.
ELON_PRIOR_STRENGTH_HOURS=168
ELON_MIN_ENTRY_EDGE=0.035
ELON_MIN_EXIT_ADVANTAGE=0.015
ELON_MIN_FAIR_PROBABILITY=0.01
ELON_ORDER_AMOUNT_USD=20
ELON_MAX_TOTAL_COST_USD=100
ELON_MAX_DAILY_BUY_USD=100
ELON_MAX_POSITIONS=3
ELON_MAX_SLIPPAGE=0.01
ELON_MIN_ENTRY_ELAPSED_MINUTES=1440
ELON_NO_NEW_POSITION_MINUTES=30
ELON_POLL_INTERVAL_SECONDS=120
ELON_TRADE_COOLDOWN_SECONDS=300
ELON_HISTORY_CACHE_PATH=elon-history-cache.json
ELON_STATE_PATH=elon-arb-state.json
ELON_AUDIT_PATH=elon-arb-audit.jsonl
ELON_DRAWDOWN_ALERT_STEP=0.05
ELON_DETERIORATION_WARNING=0.12
ELON_MAX_STRATEGY_LOSS=0.25
ELON_LABEL_FINALIZATION_DELAY_MINUTES=60
# When enabled, every three-band change includes route/GRU/V3/V4 forecasts.
ELON_FOUR_MODEL_ALERTS=false
ELON_FOUR_MODEL_PYTHON=
ELON_INTERVAL_CONFIG_PATH=config/elon-musk-oct-13-20-2026-intervals.json
ELON_GRU_ORIGINAL_RUN=models/gru-original
ELON_GRU_V3_RUN=models/gru-v3
ELON_GRU_V4_RUN=models/gru-v4
ELON_GRU_FOLD=2
ELON_GRU_DEVICE=auto
ELON_FOUR_MODEL_OUTPUT_PATH=runtime/four-model-comparison.json
ELON_FOUR_MODEL_TIMEOUT_SECONDS=120
ELON_ENABLE_LIVE=false

# Optional DingTalk robot. Keep real values out of source control.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# Local xTracker post database. Keep the real password only in your local .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=polymarket_bot
MYSQL_USER=root
MYSQL_PASSWORD=
